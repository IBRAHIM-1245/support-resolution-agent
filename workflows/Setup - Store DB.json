    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DROP VIEW IF EXISTS order_lookup;\nDROP TABLE IF EXISTS orders;\nDROP TABLE IF EXISTS customers;\n\nCREATE TABLE customers (\n  customer_id TEXT PRIMARY KEY,\n  name        TEXT NOT NULL,\n  email       TEXT NOT NULL UNIQUE,\n  city        TEXT,\n  tier        TEXT\n);\n\nCREATE TABLE orders (\n  order_id          TEXT PRIMARY KEY,\n  customer_id       TEXT NOT NULL REFERENCES customers(customer_id),\n  product           TEXT NOT NULL,\n  category          TEXT,\n  amount            NUMERIC(10,2) NOT NULL,\n  payment_method    TEXT,\n  order_date        DATE,\n  status            TEXT,\n  est_delivery_date DATE,\n  delivered_date    DATE,\n  refund_status     TEXT\n);\n\nCREATE VIEW order_lookup AS\nSELECT o.order_id, o.customer_id, c.name AS customer_name, c.email AS customer_email,\n       o.product, o.category, o.amount, o.payment_method, o.order_date,\n       o.status, o.est_delivery_date, o.delivered_date, o.refund_status\nFROM orders o\nJOIN customers c ON c.customer_id = o.customer_id;\n\nGRANT USAGE ON SCHEMA public TO shaikmart_reader;\nGRANT SELECT ON order_lookup TO shaikmart_reader;",
        "options": {}
      },
