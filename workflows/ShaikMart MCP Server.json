        "query": "SELECT order_id, product, amount, status, order_date, est_delivery_date, delivered_date, refund_status\nFROM order_lookup\nWHERE order_id = upper(trim($1))\n  AND lower(customer_email) = lower(trim($2))\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $fromAI('order_id', 'Order ID, for example ORD-1001', 'string') }},{{ $fromAI('customer_email', 'Email address used for the order', 'string') }}"
