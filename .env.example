# Copy this file to .env and fill in your own values. Never commit .env.

# Langfuse tracing (optional) - used by scripts/n8nstart.sh
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Read-only Postgres URL for the Streamlit dashboard
DASHBOARD_DB_URL=postgresql://shaikmart_reader:PASSWORD@YOUR-NEON-HOST/shaikmart?sslmode=require

# Bearer token for the MCP server (create one with: openssl rand -hex 24)
MCP_TOKEN=
